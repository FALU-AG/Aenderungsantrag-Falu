generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalType {
  AVOR
  TECHNICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestStatus {
  DRAFT
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED_FOR_IMPLEMENTATION
  IMPLEMENTATION
  AVOR_PRODUCTION_PREPARATION
  PURCHASING_PROCUREMENT
  FINAL_REVIEW
  CLOSED
}

enum ReviewAnswer {
  YES
  NO
  NOT_RELEVANT
}

enum Department {
  TECHNICAL
  AVOR
  PURCHASING
  PRODUCTION_ASSEMBLY
  AUTOMATION_SOFTWARE
  SERVICE
  SALES
  OTHER
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

enum StorageProvider {
  LOCAL
  SUPABASE
}

enum EmailNotificationType {
  PASSWORD_RESET
  USER_INVITATION
  APPROVAL_REQUIRED_AVOR
  APPROVAL_REQUIRED_TECHNICAL
  TASK_ASSIGNED
  REQUEST_CHANGES_REQUIRED
  REQUEST_APPROVED
  REQUEST_PHASE_CHANGED
  REQUEST_CLOSED
}

enum EmailNotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  BOUNCED
  COMPLAINED
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  firstName            String               @default("")
  lastName             String               @default("")
  email                String               @unique
  passwordHash         String?
  department           Department?
  active               Boolean              @default(true)
  mustChangePassword   Boolean              @default(false)
  lastLoginAt          DateTime?
  externalId           String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  roles                UserRole[]
  requests             ChangeRequest[]      @relation("Applicant")
  approvals            Approval[]           @relation("ApprovalDecisionUser")
  finalApprovals       FinalApproval[]      @relation("FinalApprovalUser")
  technicalReviews     TechnicalReview[]    @relation("TechnicalReviewCompletedBy")
  avorReviews          AvorImpactReview[]   @relation("AvorReviewCompletedBy")
  purchasingReviews    PurchasingReview[]   @relation("PurchasingReviewCompletedBy")
  placedPurchaseOrders PurchasingReview[]   @relation("PurchasingReviewOrderedBy")
  assignedTasks        Task[]               @relation("TaskResponsible")
  createdTasks         Task[]               @relation("TaskCreator")
  completedTasks       Task[]               @relation("TaskCompleter")
  attachments          Attachment[]
  comments             Comment[]
  auditEvents          AuditEvent[]
  closedRequests       ChangeRequest[]      @relation("ClosedBy")
  sessions             Session[]
  emailNotifications   EmailNotification[]
  passwordResetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  userRoles   UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model MachineType {
  id             String                     @id @default(cuid())
  code           String                     @unique
  name           String
  active         Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  legacyRequests ChangeRequest[]            @relation("LegacyMachineType")
  requests       ChangeRequestMachineType[]
}

model ChangeRequestCounter {
  year       Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model ChangeReason {
  id        String                @id @default(cuid())
  key       String                @unique
  label     String
  isOther   Boolean               @default(false)
  active    Boolean               @default(true)
  sortOrder Int
  requests  ChangeRequestReason[]
}

model ChangeRequest {
  id                  String                     @id @default(cuid())
  number              String                     @unique
  title               String                     @default("")
  applicantId         String
  applicantName       String                     @default("")
  legacyMachineTypeId String?                    @map("machineTypeId")
  articleNumber       String?
  articleDescription  String?
  description         String                     @default("")
  otherReasonText     String?
  status              ChangeRequestStatus        @default(DRAFT)
  approvalCycle       Int                        @default(1)
  finalReviewCycle    Int                        @default(1)
  finalComment        String?
  version             Int                        @default(1)
  submittedAt         DateTime?
  closedAt            DateTime?
  closedById          String?
  closingRemarks      String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  applicant           User                       @relation("Applicant", fields: [applicantId], references: [id])
  legacyMachineType   MachineType?               @relation("LegacyMachineType", fields: [legacyMachineTypeId], references: [id])
  machineTypes        ChangeRequestMachineType[]
  closedBy            User?                      @relation("ClosedBy", fields: [closedById], references: [id])
  reasons             ChangeRequestReason[]
  approvals           Approval[]
  finalApprovals      FinalApproval[]
  technicalReview     TechnicalReview?
  avorImpactReview    AvorImpactReview?
  purchasingReview    PurchasingReview?
  tasks               Task[]
  attachments         Attachment[]
  comments            Comment[]
  auditEvents         AuditEvent[]
  emailNotifications  EmailNotification[]

  @@index([status])
  @@index([legacyMachineTypeId])
  @@index([applicantId])
  @@index([updatedAt])
}

model ChangeRequestMachineType {
  changeRequestId String
  machineTypeId   String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  machineType     MachineType   @relation(fields: [machineTypeId], references: [id], onDelete: Restrict)

  @@id([changeRequestId, machineTypeId])
  @@index([machineTypeId])
}

model ChangeRequestReason {
  changeRequestId String
  changeReasonId  String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  changeReason    ChangeReason  @relation(fields: [changeReasonId], references: [id])

  @@id([changeRequestId, changeReasonId])
}

model Approval {
  id              String         @id @default(cuid())
  changeRequestId String
  type            ApprovalType
  status          ApprovalStatus @default(PENDING)
  cycle           Int
  decisionUserId  String?
  decidedAt       DateTime?
  comment         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  changeRequest   ChangeRequest  @relation(fields: [changeRequestId], references: [id])
  decisionUser    User?          @relation("ApprovalDecisionUser", fields: [decisionUserId], references: [id])

  @@unique([changeRequestId, type, cycle])
  @@index([status, type])
}

model FinalApproval {
  id              String        @id @default(cuid())
  changeRequestId String
  cycle           Int
  type            ApprovalType
  approvedById    String
  approvedAt      DateTime      @default(now())
  comment         String?
  createdAt       DateTime      @default(now())
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id])
  approvedBy      User          @relation("FinalApprovalUser", fields: [approvedById], references: [id])

  @@unique([changeRequestId, cycle, type])
  @@index([changeRequestId, cycle])
}

model TechnicalReview {
  id                         String        @id @default(cuid())
  changeRequestId            String        @unique
  operatingSafety            ReviewAnswer?
  operatingSafetyComment     String?
  interchangeability         ReviewAnswer?
  interchangeabilityComment  String?
  affectsOthers              ReviewAnswer?
  affectedItemsExplanation   String?
  existingArticlesUsable     ReviewAnswer?
  existingArticlesAction     String?
  nextSteps                  String?
  implementationNotes        String?
  sparePartsCatalogueUpdated ReviewAnswer?
  sparePartsCatalogueComment String?
  manufacturingDocsUpdated   ReviewAnswer?
  manufacturingDocsComment   String?
  completed                  Boolean       @default(false)
  completedById              String?
  completedAt                DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  changeRequest              ChangeRequest @relation(fields: [changeRequestId], references: [id])
  completedBy                User?         @relation("TechnicalReviewCompletedBy", fields: [completedById], references: [id])
}

model AvorImpactReview {
  id                           String        @id @default(cuid())
  changeRequestId              String        @unique
  stockNeedsAction             ReviewAnswer?
  stockActionExplanation       String?
  purchaseOrdersNeedUpdate     ReviewAnswer?
  purchaseOrderExplanation     String?
  productionOrdersNeedUpdate   ReviewAnswer?
  productionOrderExplanation   String?
  deliveredMachinesNeedParts   ReviewAnswer?
  deliveredMachinesExplanation String?
  validFromMachineNumber       String?
  estimatedAdditionalCosts     Decimal?      @db.Decimal(12, 2)
  currency                     String        @default("CHF")
  remarks                      String?
  completed                    Boolean       @default(false)
  completedById                String?
  completedAt                  DateTime?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  changeRequest                ChangeRequest @relation(fields: [changeRequestId], references: [id])
  completedBy                  User?         @relation("AvorReviewCompletedBy", fields: [completedById], references: [id])
}

model PurchasingReview {
  id                   String        @id @default(cuid())
  changeRequestId      String        @unique
  purchasingRequired   Boolean?
  supplier             String?
  supplierNotes        String?
  notes                String?
  orderRequired        Boolean?
  orderCompleted       Boolean       @default(false)
  orderNumber          String?
  orderDate            DateTime?
  orderedById          String?
  expectedDeliveryDate DateTime?
  completed            Boolean       @default(false)
  completedById        String?
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  changeRequest        ChangeRequest @relation(fields: [changeRequestId], references: [id])
  completedBy          User?         @relation("PurchasingReviewCompletedBy", fields: [completedById], references: [id])
  orderedBy            User?         @relation("PurchasingReviewOrderedBy", fields: [orderedById], references: [id])
}

model Task {
  id                 String              @id @default(cuid())
  changeRequestId    String
  title              String
  description        String?
  responsibleUserId  String?
  department         Department
  dueDate            DateTime?
  priority           TaskPriority        @default(NORMAL)
  status             TaskStatus          @default(OPEN)
  requiredForClosure Boolean             @default(true)
  createdById        String
  completedById      String?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  changeRequest      ChangeRequest       @relation(fields: [changeRequestId], references: [id])
  responsibleUser    User?               @relation("TaskResponsible", fields: [responsibleUserId], references: [id])
  createdBy          User                @relation("TaskCreator", fields: [createdById], references: [id])
  completedBy        User?               @relation("TaskCompleter", fields: [completedById], references: [id])
  emailNotifications EmailNotification[]

  @@index([responsibleUserId, status])
  @@index([dueDate, status])
  @@index([changeRequestId, status])
}

model EmailNotification {
  id                String                  @id @default(cuid())
  type              EmailNotificationType
  idempotencyKey    String                  @unique
  recipientUserId   String?
  recipientEmail    String
  recipientName     String?
  changeRequestId   String?
  taskId            String?
  subject           String
  templateData      Json?
  status            EmailNotificationStatus @default(PENDING)
  providerMessageId String?                 @unique
  attemptCount      Int                     @default(0)
  lastError         String?
  nextAttemptAt     DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  sentAt            DateTime?
  failedAt          DateTime?
  recipientUser     User?                   @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  changeRequest     ChangeRequest?          @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  task              Task?                   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([changeRequestId, createdAt])
  @@index([taskId, createdAt])
}

model Attachment {
  id              String          @id @default(cuid())
  changeRequestId String
  originalName    String
  storageKey      String          @unique
  storageProvider StorageProvider @default(LOCAL)
  mimeType        String
  sizeBytes       Int
  category        String?
  uploadedById    String
  uploadedAt      DateTime        @default(now())
  deletedAt       DateTime?
  changeRequest   ChangeRequest   @relation(fields: [changeRequestId], references: [id])
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])
}

model Comment {
  id              String        @id @default(cuid())
  changeRequestId String
  authorId        String
  text            String
  createdAt       DateTime      @default(now())
  editedAt        DateTime?
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id])
  author          User          @relation(fields: [authorId], references: [id])
}

model AuditEvent {
  id              String         @id @default(cuid())
  changeRequestId String?
  userId          String?
  action          String
  entityType      String
  entityId        String?
  summary         String
  details         Json?
  timestamp       DateTime       @default(now())
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])

  @@index([changeRequestId, timestamp])
}

model AppSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}
