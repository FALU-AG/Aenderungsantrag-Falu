DATABASE_URL="postgresql://falu:falu_local_dev@localhost:5432/falu_change_request?schema=public"

# Zentrale Anmeldung. Der private Signaturschluessel liegt ausschliesslich im Portal;
# diese Anwendung erhaelt nur den oeffentlichen Schluessel und das Verzeichnis-Credential.
# Ohne FALU_APP_SIGNING_PUBLIC_KEY weist die Anwendung jede Anfrage ab.
FALU_APP_SIGNING_PUBLIC_KEY=""
FALU_CHANGE_REQUEST_DIRECTORY_SECRET=""
# Ohne Angabe jeweils https://admin.falu.com
FALU_PORTAL_ORIGIN=""
FALU_PORTAL_SERVICE_ORIGIN=""
# Gemeinsames Geheimnis mit dem Cloudflare Worker. Solange leer, wird nicht geprueft,
# ob eine Anfrage ueber den Worker kam; gesetzt werden nur noch dessen Anfragen bedient.
FALU_ORIGIN_LOCK=""

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
AI_PROVIDER=""
OPENAI_API_KEY=""
# Optional override; otherwise speech follows AI_PROVIDER.
SPEECH_PROVIDER=""
OPENAI_TEXT_MODEL="gpt-5.6"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
# Nur fuer lokale Entwicklung. Anmelden kann man sich mit diesen Konten nicht,
# es gibt keine lokale Anmeldung mehr.
SEED_DEMO_USERS=false
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="FALU Change Request <change-request@example.invalid>"
EMAIL_MODE="disabled"
EMAIL_REDIRECT_TO=""
APP_BASE_URL="http://localhost:3000/aenderungsantrag"
SLACK_BOT_TOKEN=""
SLACK_NOTIFICATIONS_ENABLED="false"
SLACK_NOTIFICATION_MODE="production"
SLACK_TEST_RECIPIENT_USER_ID=""
